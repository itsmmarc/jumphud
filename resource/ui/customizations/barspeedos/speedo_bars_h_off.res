"speedo_bars_h_off.res"{
    "barspeedos"
    {
        "combined_overlay" {    // invisible when either speedo is disabled
                "visible" "0"
        }
        "vspeedo_container" {
            "vspeedo_overlay" { // visible when hspeedo is disabled
                "visible"   "1"
            }
        }
        "hspeedo_container" {
            "visible"   "0"
        }
        "background_container" {
            "hspeedo_background" {
                "visible"   "0"
            }
        }
    }
}