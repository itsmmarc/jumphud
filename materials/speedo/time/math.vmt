"UnlitGeneric"
{
        // MARK: Variables
        // ==============================================================
        // DIGIT SEPERATION VARIABLES
        // ==============================================================
        "$debugTime"                            "0"
        "$blankFrame"                           "110"
        "$isLeft"                               "0"
        "$isRight"                              "0"
        "$offset"                               "0"
        "$modulus"                              "0"
        "$numDigits"                            "0"
        "$temp"                                 "0"
        "$is4Digit"                             "0"
        "$is3Digit"                             "0"
        "$is2Digit"                             "0"
        "$is1Digit"                             "0"
        "$is1DigitAndLeft"                      "0"
        "$is1DigitAndRight"                     "0"
        "$is2DigitAndLeft"                      "0"
        "$is2DigitAndRight"                     "0"
        "$is3DigitAndLeft"                      "0"
        "$is3DigitAndRight"                     "0"
        "$is4DigitAndLeft"                      "0"
        "$is4DigitAndRight"                     "0"
        "$isGT3Digit"                           "0"
        "$leadingZero"                          "0"
        // ==============================================================
        // TEXTURE TRANSFORMATION VARIABLES
        // ==============================================================
        "$totalWidth"                           "256"
        "$width"                                "33"	// change depending on font
        "$center"                               "[0.5 0.5]"
        "$scale"                                "[1 1]"
        "$rotate"                               "0"
        "$translate"                            "[0.0 0.0]"
        //
        "$colorLeft"                            "{0 0 255}"
        "$colorRight"                           "{255 0 0}"
        //
        "$frame"                                "0"
        "$time"                                 "0.0"
        "$60"                                   "60"
        "Proxies"
        {
                // get time (seconds)
                "CurrentTime"
                {
                        "resultVar"                     "$time"
                }
                // convert time to minutes
                "Divide"
                {
                        "srcVar1"                       "$time"
                        "srcVar2"                       "$60"
                        "resultVar"                     "$frame"
                }
                // ==============================================================
                // MARK: DIGIT SEPERATION
                // ==============================================================
                // speed = frame;
                "SelectFirstIfNonZero"
                {
                        "srcVar1"                       "$debugTime"
                        "srcVar2"                       "$frame"
                        "resultVar"                     "$time"
                }
                // "Equals"
                // {
                // "srcVar1"                       "$frame"
                // "resultVar"                     "$time"
                // }
                // isLeft = !isRight
                "Subtract"
                {
                        "srcVar1"                       "$1"
                        "srcVar2"                       "$isLeft"
                        "resultVar"                     "$isRight"
                }
                /////////////////////////////////////////////////////////////
                // if (speed < 10000) is4Digit == 1;
                "LessOrEqual"
                {
                        "srcVar1"                       "$time"
                        "srcVar2"                       "$9999"
                        "resultVar"                     "$is4Digit"
                        "lessEqualVar"                  "$1"
                        "greaterVar"                    "$0"
                }
                // if (speed < 10000) is4Digit == 1;
                "LessOrEqual"
                {
                        "srcVar1"                       "$time"
                        "srcVar2"                       "$999"
                        "resultVar"                     "$isGT3Digit"
                        "lessEqualVar"                  "$0"
                        "greaterVar"                    "$1"
                }
                // if (speed < 1000) is3Digit == 1;
                "LessOrEqual"
                {
                        "srcVar1"                       "$time"
                        "srcVar2"                       "$999"
                        "resultVar"                     "$is3Digit"
                        "lessEqualVar"                  "$1"
                        "greaterVar"                    "$0"
                }
                // if (speed < 100) is2Digit == 1;
                "LessOrEqual"
                {
                        "srcVar1"                       "$time"
                        "srcVar2"                       "$99"
                        "resultVar"                     "$is2Digit"
                        "lessEqualVar"                  "$1"
                        "greaterVar"                    "$0"
                }
                // if (speed < 10) is1Digit == 1;
                "LessOrEqual"
                {
                        "srcVar1"                       "$time"
                        "srcVar2"                       "$9"
                        "resultVar"                     "$is1Digit"
                        "lessEqualVar"                  "$1"
                        "greaterVar"                    "$0"
                }
                // if (speed > 99) leadingZero = 1;
                "LessOrEqual"
                {
                        "srcVar1"                       "$time"
                        "srcVar2"                       "$99"
                        "resultVar"                     "$leadingZero"
                        "lessEqualVar"                  "$0"
                        "greaterVar"                    "$1"
                }
                "Multiply"
                {
                        "srcVar1"                       "$leadingZero"
                        "srcVar2"                       "$isRight"
                        "resultVar"                     "$leadingZero"
                }
                /////////////////////////////////////////////////////////////
                // if (is1Digit && isLeft) is1DigitAndLeft = 1;
                "Multiply"
                {
                        "srcVar1"                       "$is1Digit"
                        "srcVar2"                       "$isLeft"
                        "resultVar"                     "$is1DigitAndLeft"
                }
                // if (is1Digit && !isLeft) is1DigitAndRight = 1;
                "Multiply"
                {
                        "srcVar1"                       "$is1Digit"
                        "srcVar2"                       "$isRight"
                        "resultVar"                     "$is1DigitAndRight"
                }
                // if (is2Digit && isLeft) is2DigitAndLeft = 1;
                "Multiply"
                {
                        "srcVar1"                       "$is2Digit"
                        "srcVar2"                       "$isLeft"
                        "resultVar"                     "$is2DigitAndLeft"
                }
                // if (is2Digit && !isLeft) is2DigitAndRight = 1;
                "Multiply"
                {
                        "srcVar1"                       "$is2Digit"
                        "srcVar2"                       "$isRight"
                        "resultVar"                     "$is2DigitAndRight"
                }
                // if (is3Digit && isLeft) is3DigitAndLeft = 1;
                "Multiply"
                {
                        "srcVar1"                       "$is3Digit"
                        "srcVar2"                       "$isLeft"
                        "resultVar"                     "$is3DigitAndLeft"
                }
                // if (is3Digit && !isLeft) is3DigitAndRight = 1;
                "Multiply"
                {
                        "srcVar1"                       "$is3Digit"
                        "srcVar2"                       "$isRight"
                        "resultVar"                     "$is3DigitAndRight"
                }
                // if (is4Digit && isLeft) is4DigitAndLeft = 1;
                "Multiply"
                {
                        "srcVar1"                       "$is4Digit"
                        "srcVar2"                       "$isLeft"
                        "resultVar"                     "$is4DigitAndLeft"
                }
                // if (is4Digit && !isLeft) is4DigitAndRight = 1;
                "Multiply"
                {
                        "srcVar1"                       "$is4Digit"
                        "srcVar2"                       "$isRight"
                        "resultVar"                     "$is4DigitAndRight"
                }
                /////////////////////////////////////////////////////////////
                // 4 DIGITS
                // modulus = speed / 100;
                "Divide"
                {
                        "srcVar1"                       "$time"
                        "srcVar2"                       "$100"
                        "resultVar"                     "$modulus"
                }
                // modulus = parseInt(modulus);
                "Int"
                {
                        "srcVar1"                       "$modulus"
                        "resultVar"                     "$modulus"
                }
                // if (isLeft) temp = 1; else temp = 100;
                "LessOrEqual"
                {
                        "srcVar1"                       "$isLeft"
                        "srcVar2"                       "$0"
                        "resultVar"                     "$temp"
                        "lessEqualVar"                  "$100"
                        "greaterVar"                    "$1"
                }
                // modulus = modulus * temp;
                "Multiply"
                {
                        "srcVar1"                       "$modulus"
                        "srcVar2"                       "$temp"
                        "resultVar"                     "$modulus"
                }
                // temp = speed - modulus;
                "Subtract"
                {
                        "srcVar1"                       "$time"
                        "srcVar2"                       "$modulus"
                        "resultVar"                     "$temp"
                }
                // if (is4DigitAndLeft) frame = modulus;
                "LessOrEqual"
                {
                        "srcVar1"                       "$is4DigitAndLeft"
                        "srcVar2"                       "$0"
                        "resultVar"                     "$frame"
                        "lessEqualVar"                  "$frame"
                        "greaterVar"                    "$modulus"
                }
                // if (is4DigitAndRight) frame = temp;
                "LessOrEqual"
                {
                        "srcVar1"                       "$is4DigitAndRight"
                        "srcVar2"                       "$0"
                        "resultVar"                     "$frame"
                        "lessEqualVar"                  "$frame"
                        "greaterVar"                    "$temp"
                }
                //// if (is4DigitAndRight) offset = 1;
                "LessOrEqual"
                {
                        "srcVar1"                       "$is4DigitAndRight"
                        "srcVar2"                       "$0"
                        "resultVar"                     "$offset"
                        "lessEqualVar"                  "$offset"
                        "greaterVar"                    "$-1"
                }
                /////////////////////////////////////////////////////////////
                // 3 DIGITS
                // modulus = speed / 10;
                "Divide"
                {
                        "srcVar1"                       "$time"
                        "srcVar2"                       "$10"
                        "resultVar"                     "$modulus"
                }
                // modulus = parseInt(modulus);
                "Int"
                {
                        "srcVar1"                       "$modulus"
                        "resultVar"                     "$modulus"
                }
                // if (isLeft) temp = 1; else temp = 10;
                "LessOrEqual"
                {
                        "srcVar1"                       "$isLeft"
                        "srcVar2"                       "$0"
                        "resultVar"                     "$temp"
                        "lessEqualVar"                  "$10"
                        "greaterVar"                    "$1"
                }
                // modulus = modulus * temp;
                "Multiply"
                {
                        "srcVar1"                       "$modulus"
                        "srcVar2"                       "$temp"
                        "resultVar"                     "$modulus"
                }
                // temp = speed - modulus;
                "Subtract"
                {
                        "srcVar1"                       "$time"
                        "srcVar2"                       "$modulus"
                        "resultVar"                     "$temp"
                }
                // if (is3DigitAndLeft) frame = modulus;
                "LessOrEqual"
                {
                        "srcVar1"                       "$is3DigitAndLeft"
                        "srcVar2"                       "$0"
                        "resultVar"                     "$frame"
                        "lessEqualVar"                  "$frame"
                        "greaterVar"                    "$modulus"
                }
                // if (is3DigitAndRight) frame = temp;
                "LessOrEqual"
                {
                        "srcVar1"                       "$is3DigitAndRight"
                        "srcVar2"                       "$0"
                        "resultVar"                     "$frame"
                        "lessEqualVar"                  "$frame"
                        "greaterVar"                    "$temp"
                }
                // LEADING ZERO
                "Add"
                {
                        "srcVar1"                       "$frame"
                        "srcVar2"                       "$100"
                        "resultVar"                     "$temp"
                }
                "LessOrEqual"
                {
                        "srcVar1"                       "$temp"
                        "srcVar2"                       "$109"
                        "resultVar"                     "$leadingZero"
                        "lessEqualVar"                  "$leadingZero"
                        "greaterVar"                    "$0"
                }
                "LessOrEqual"
                {
                        "srcVar1"                       "$isGT3Digit"
                        "srcVar2"                       "$0"
                        "resultVar"                     "$leadingZero"
                        "lessEqualVar"                  "$0"
                        "greaterVar"                    "$leadingZero"
                }
                "LessOrEqual"
                {
                        "srcVar1"                       "$leadingZero"
                        "srcVar2"                       "$0"
                        "resultVar"                     "$frame"
                        "lessEqualVar"                  "$frame"
                        "greaterVar"                    "$temp"
                }
                //// if (is3DigitAndRight) offset = 1;
                "LessOrEqual"
                {
                        "srcVar1"                       "$is3DigitAndRight"
                        "srcVar2"                       "$0"
                        "resultVar"                     "$offset"
                        "lessEqualVar"                  "$offset"
                        "greaterVar"                    "$0"
                }
                /////////////////////////////////////////////////////////////
                // 2 DIGITS
                // if (is2DigitAndLeft) frame = speed;
                "LessOrEqual"
                {
                        "srcVar1"                       "$is2DigitAndLeft"
                        "srcVar2"                       "$0"
                        "resultVar"                     "$frame"
                        "lessEqualVar"                  "$frame"
                        "greaterVar"                    "$time"
                }
                // if (is2DigitAndRight) frame = blank;
                "LessOrEqual"
                {
                        "srcVar1"                       "$is2DigitAndRight"
                        "srcVar2"                       "$0"
                        "resultVar"                     "$frame"
                        "lessEqualVar"                  "$frame"
                        "greaterVar"                    "$blankFrame"
                }
                /////////////////////////////////////////////////////////////
                // if (isLeft) offset = -1;
                "LessOrEqual"
                {
                        "srcVar1"                       "$isLeft"
                        "srcVar2"                       "$0"
                        "resultVar"                     "$offset"
                        "lessEqualVar"                  "$offset"
                        "greaterVar"                    "$1"
                }
                // if (isLeft) offset = -1;
                "LessOrEqual"
                {
                        "srcVar1"                       "$is1DigitAndLeft"
                        "srcVar2"                       "$0"
                        "resultVar"                     "$offset"
                        "lessEqualVar"                  "$offset"
                        "greaterVar"                    "$2"
                }
                /////////////////////////////////////////////////////////////
                // MARK: TRANSLATE
                // offset
                "Divide"
                {
                        "srcVar1"                       "$width"
                        "srcVar2"                       "$totalWidth"
                        "resultVar"                     "$temp"
                }
                "Multiply"
                {
                        "srcVar1"                       "$temp"
                        "srcVar2"                       "$offset"
                        "resultVar"                     "$offset"
                }
                // left align offset
                "Divide"
                {
                        "srcVar1"                       "$totalWidth"
                        "srcVar2"                       "$2"
                        "resultVar"                     "$temp"
                }
                "Subtract"
                {
                        "srcVar1"                       "$temp"
                        "srcVar2"                       "$width"
                        "resultVar"                     "$temp"
                }
                "Subtract"
                {
                        "srcVar1"                       "$temp"
                        "srcVar2"                       "$width"
                        "resultVar"                     "$temp"
                }
                "Divide"
                {
                        "srcVar1"                       "$temp"
                        "srcVar2"                       "$totalWidth"
                        "resultVar"                     "$temp"
                }
                // combine offsets
                "Add"
                {
                        "srcVar1"                       "$offset"
                        "srcVar2"                       "$temp"
                        "resultVar"                     "$temp"
                }
                // apply offset
                "Equals"
                {
                        "srcVar1"                       "$temp"
                        "resultVar"                     "$translate[0]"
                }
                "TextureTransform"
                {
                        "centerVar"                     "$center"
                        "scaleVar"                      "$scale"
                        "rotateVar"                     "$rotate"
                        "translateVar"                  "$translate"
                        "resultVar"                     "$basetexturetransform"
                }
                /////////////////////////////////////////////////////////////
                // MARK: DEBUG
                // "LessOrEqual"
                // {
                // "srcVar1"                       "$isLeft"
                // "srcVar2"                       "$0"
                // "resultVar"                     "$color"
                // "lessEqualVar"                  "$color"
                // "greaterVar"                    "$colorLeft"
                // }
                // "LessOrEqual"
                // {
                // "srcVar1"                       "$isRight"
                // "srcVar2"                       "$0"
                // "resultVar"                     "$color"
                // "lessEqualVar"                  "$color"
                // "greaterVar"                    "$colorRight"
                // }
        }
}