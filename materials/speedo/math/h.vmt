"UnlitGeneric"
{
        // MARK: Variables
        // ==============================================================
        // DIGIT SEPERATION VARIABLES
        // ==============================================================
        "$debugSpeed"                           "0"
        "$blankFrame"                           "110"
        "$isLeft"                               "0"
        "$isRight"                              "0"
        "$offset"                               "0"
        "$modulus"                              "0"
        "$numDigits"                            "0"
        "$temp"                                 "0"
        "$is4Digit"                             "0"
        "$is3Digit"                             "0"
        "$is2Digit"                             "0"
        "$is1Digit"                             "0"
        "$is1DigitAndLeft"                      "0"
        "$is1DigitAndRight"                     "0"
        "$is2DigitAndLeft"                      "0"
        "$is2DigitAndRight"                     "0"
        "$is3DigitAndLeft"                      "0"
        "$is3DigitAndRight"                     "0"
        "$is4DigitAndLeft"                      "0"
        "$is4DigitAndRight"                     "0"
        "$leadingZero"                          "0"
        // ==============================================================
        // TEXTURE TRANSFORMATION VARIABLES
        // ==============================================================
        "$totalWidth"                           "256"
        "$width"                                "33"	// change depending on font
        "$center"                               "[0.5 0.5]"
        "$scale"                                "[1 1]"
        "$rotate"                               "0"
        "$translate"                            "[0.0 0.0]"
        // ==============================================================
        // UPDATE RATE VARIABLES
        // ==============================================================
        "$framerate"                            "30"
        "$fullframe"                            "0"
        "$time"                                 "0"
        "$oldtime"                              "0"
        "$interval"                             "0"
        "$const_interval"                       "0"
        "$update"                               "0"
        // ==============================================================
        // SPEEDO CALCULATION VARIABLES
        // ==============================================================
        "$pos"                                  "[0.0 0.0 0.0]"
        "$x"                                    "0.0"
        "$prev_x"                               "0.0"
        "$dx"                                   "0.0"
        "$dxs"                                  "0.0"
        "$y"                                    "0.0"
        "$prev_y"                               "0.0"
        "$dy"                                   "0.0"
        "$dys"                                  "0.0"
        "$z"                                    "0.0"
        "$prev_z"                               "0.0"
        "$dz"                                   "0.0"
        "$time"                                 "0.0"
        "$prev_t"                               "0.0"
        "$dt"                                   "0.0"
        "$v"                                    "0.0"
        "$prev_v"                               "0.0"
        "$dv"                                   "0.0"
        "$timer"                                "0.0"
        "$total_dist"                           "0.0"
        "$speedo"                               "0.0"
        "$speedo_value"                         "0.0"
        "$prev_timer"                           "0.0"
        "$prev_total_dist"                      "0.0"
        "$dist"                                 "0.0"
        "$number"                               "0.0"
        "$sqrt"                                 "0.0"
        "$timer_delay"                          "0.1"
        "$tmp"                                  "0.0"
        "$eps"                                  "0.001953125"
        "$value"                                "0.0"
        "$speed"                                "0"
        // ==============================================================
        // COLOR VARIABLES
        // ==============================================================
        "$colorMain"                            "{ 255 255 255 }"	// default color
        "$color"                                "$colorMain"
        // rainbow color vars
        "$enableRainbow"                        "0"
        "$rainbowColor"                         "[1 1 1]"
        "$iRandRedBool"                         "0"
        "$rainbowRed"                           "1.0"
        "$rainbowRedI"                          "0.0"
        "$rainbowRedD"                          "0.0"
        "$iRandGreenBool"                       "0"
        "$rainbowGreen"                         "1.0"
        "$rainbowGreenI"                        "0.0"
        "$rainbowGreenD"                        "0.0"
        "$iRandBlueBool"                        "0"
        "$rainbowBlue"                          "1.0"
        "$rainbowBlueI"                         "0.0"
        "$rainbowBlueD"                         "0.0"
        "$diff"                                 "0.004"	// 0.004
        "Proxies"
        {
                // ==============================================================
                // MARK: UPDATE RATE
                // ==============================================================
                // get const_interval
                // const_interval = 1/framerate
                "Divide"
                {
                        "srcVar1"                       "$1"
                        "srcVar2"                       "$framerate"
                        "resultVar"                     "$const_interval"
                }
                // Reset oldtime on new map
                // if(oldtime>time){oldtime=0}
                "LessOrEqual"
                {
                        "srcVar1"                       "$oldtime"
                        "srcVar2"                       "$time"
                        "resultVar"                     "$oldtime"
                        "greaterVar"                    "$0"
                        "lessEqualVar"                  "$oldtime"
                }
                // Get current time
                "CurrentTime"
                {
                        "resultVar"                     "$time"
                }
                // Calculate current interval
                // interval = time - oldtime
                "Subtract"
                {
                        "srcVar1"                       "$time"
                        "srcVar2"                       "$oldtime"
                        "resultVar"                     "$interval"
                }
                // Sets $update to 1 if it's time to update
                // if(interval>const_interval){update=1}
                "LessOrEqual"
                {
                        "srcVar1"                       "$interval"
                        "srcVar2"                       "$const_interval"
                        "resultVar"                     "$update"
                        "greaterVar"                    "$1"
                        "lessEqualVar"                  "$0"
                }
                // Save current time if updating
                // if(update==1){oldtime=time}
                "LessOrEqual"
                {
                        "srcVar1"                       "$update"
                        "srcVar2"                       "$0"
                        "resultVar"                     "$oldtime"
                        "greaterVar"                    "$time"
                        "lessEqualVar"                  "$oldtime"
                }
                // ==============================================================
                // MARK: HORIZONTAL SPEED
                // ==============================================================
                // get player position
                "PlayerPosition"
                {
                        "scale"                         "1"
                        "resultVar"                     "$pos"
                }
                "Clamp"
                {
                        "srcVar1"                       "$0"
                        "min"                           "$pos[0]"
                        "max"                           "$pos[0]"
                        "resultVar"                     "$x"
                }
                "Clamp"
                {
                        "srcVar1"                       "$0"
                        "min"                           "$pos[1]"
                        "max"                           "$pos[1]"
                        "resultVar"                     "$y"
                }
                "Clamp"
                {
                        "srcVar1"                       "$0"
                        "min"                           "$pos[2]"
                        "max"                           "$pos[2]"
                        "resultVar"                     "$z"
                }
                // get player absolute velocity
                "PlayerSpeed"
                {
                        "scale"                         "1"
                        "resultVar"                     "$v"
                }
                // get game time
                "CurrentTime"
                {
                        "resultVar"                     "$time"
                }
                // dx = x - prev_x, dy = y - prev_y, dz = z - prev_z, dt = t - prev_t, dv = abs(v - prev_v)
                "Subtract"
                {
                        "srcVar1"                       "$x"
                        "srcVar2"                       "$prev_x"
                        "resultVar"                     "$dx"
                }
                "Subtract"
                {
                        "srcVar1"                       "$y"
                        "srcVar2"                       "$prev_y"
                        "resultVar"                     "$dy"
                }
                "Subtract"
                {
                        "srcVar1"                       "$z"
                        "srcVar2"                       "$prev_z"
                        "resultVar"                     "$dz"
                }
                "Subtract"
                {
                        "srcVar1"                       "$time"
                        "srcVar2"                       "$prev_t"
                        "resultVar"                     "$dt"
                }
                "Subtract"
                {
                        "srcVar1"                       "$v"
                        "srcVar2"                       "$prev_v"
                        "resultVar"                     "$dv"
                }
                "Abs"
                {
                        "srcVar1"                       "$dv"
                        "resultVar"                     "$dv"
                }
                // dxs = dx*dx, dys = dy*dy
                "Multiply"
                {
                        "srcVar1"                       "$dx"
                        "srcVar2"                       "$dx"
                        "resultVar"                     "$dxs"
                }
                "Multiply"
                {
                        "srcVar1"                       "$dy"
                        "srcVar2"                       "$dy"
                        "resultVar"                     "$dys"
                }
                // dist = sqrt(dx^2 + dy^2)
                // initial guess = abs(dx) + abs(dy)
                "Abs"
                {
                        "srcVar1"                       "$dx"
                        "resultVar"                     "$sqrt"
                }
                "Abs"
                {
                        "srcVar1"                       "$dy"
                        "resultVar"                     "$tmp"
                }
                "Add"
                {
                        "srcVar1"                       "$tmp"
                        "srcVar2"                       "$sqrt"
                        "resultVar"                     "$sqrt"
                }
                // number we want to sqrt
                "Add"
                {
                        "srcVar1"                       "$dxs"
                        "srcVar2"                       "$dys"
                        "resultVar"                     "$number"
                }
                // sqrt using 4 iterations of newtons method -> sqrt = 0.5(sqrt + number/sqrt)
                "Divide"
                {
                        "srcVar1"                       "$number"
                        "srcVar2"                       "$sqrt"
                        "resultVar"                     "$tmp"
                }
                "Add"
                {
                        "srcVar1"                       "$tmp"
                        "srcVar2"                       "$sqrt"
                        "resultVar"                     "$tmp"
                }
                "Multiply"
                {
                        "srcVar1"                       "$tmp"
                        "srcVar2"                       "$0.5"
                        "resultVar"                     "$sqrt"
                }
                "Divide"
                {
                        "srcVar1"                       "$number"
                        "srcVar2"                       "$sqrt"
                        "resultVar"                     "$tmp"
                }
                "Add"
                {
                        "srcVar1"                       "$tmp"
                        "srcVar2"                       "$sqrt"
                        "resultVar"                     "$tmp"
                }
                "Multiply"
                {
                        "srcVar1"                       "$tmp"
                        "srcVar2"                       "$0.5"
                        "resultVar"                     "$sqrt"
                }
                "Divide"
                {
                        "srcVar1"                       "$number"
                        "srcVar2"                       "$sqrt"
                        "resultVar"                     "$tmp"
                }
                "Add"
                {
                        "srcVar1"                       "$tmp"
                        "srcVar2"                       "$sqrt"
                        "resultVar"                     "$tmp"
                }
                "Multiply"
                {
                        "srcVar1"                       "$tmp"
                        "srcVar2"                       "$0.5"
                        "resultVar"                     "$sqrt"
                }
                "Divide"
                {
                        "srcVar1"                       "$number"
                        "srcVar2"                       "$sqrt"
                        "resultVar"                     "$tmp"
                }
                "Add"
                {
                        "srcVar1"                       "$tmp"
                        "srcVar2"                       "$sqrt"
                        "resultVar"                     "$tmp"
                }
                "Multiply"
                {
                        "srcVar1"                       "$tmp"
                        "srcVar2"                       "$0.5"
                        "resultVar"                     "$dist"
                }
                // dist = sqrt
                // if (dist <= 100): // not being teled
                // total_dist += dist
                "LessOrEqual"
                {
                        "srcVar1"                       "$dist"
                        "srcVar2"                       "$100"
                        "lessEqualVar"                  "$dist"
                        "greaterVar"                    "$0"
                        "resultVar"                     "$tmp"
                }
                "Add"
                {
                        "srcVar1"                       "$total_dist"
                        "srcVar2"                       "$tmp"
                        "resultVar"                     "$total_dist"
                }
                // timer += dt
                "LessOrEqual"
                {
                        "srcVar1"                       "$dist"
                        "srcVar2"                       "$100"
                        "lessEqualVar"                  "$dt"
                        "greaterVar"                    "$0"
                        "resultVar"                     "$tmp"
                }
                "Add"
                {
                        "srcVar1"                       "$timer"
                        "srcVar2"                       "$tmp"
                        "resultVar"                     "$timer"
                }
                // if (dv >= 100): // detect getting hit by rocket/ jumping / bonking something
                // prev_timer = 0.0
                "LessOrEqual"
                {
                        "srcVar1"                       "$100"
                        "srcVar2"                       "$dv"
                        "lessEqualVar"                  "$0"
                        "greaterVar"                    "$prev_timer"
                        "resultVar"                     "$prev_timer"
                }
                // prev_total_dist = 0.0
                "LessOrEqual"
                {
                        "srcVar1"                       "$100"
                        "srcVar2"                       "$dv"
                        "lessEqualVar"                  "$0"
                        "greaterVar"                    "$prev_total_dist"
                        "resultVar"                     "$prev_total_dist"
                }
                // timer = 0.0
                "LessOrEqual"
                {
                        "srcVar1"                       "$100"
                        "srcVar2"                       "$dv"
                        "lessEqualVar"                  "$0"
                        "greaterVar"                    "$timer"
                        "resultVar"                     "$timer"
                }
                // total_dist = 0.0
                "LessOrEqual"
                {
                        "srcVar1"                       "$100"
                        "srcVar2"                       "$dv"
                        "lessEqualVar"                  "$0"
                        "greaterVar"                    "$total_dist"
                        "resultVar"                     "$total_dist"
                }
                // speedo_value = (total_dist + prev_total_dist) / (timer + prev_timer)
                "Add"
                {
                        "srcVar1"                       "$total_dist"
                        "srcVar2"                       "$prev_total_dist"
                        "resultVar"                     "$tmp"
                }
                "Add"
                {
                        "srcVar1"                       "$timer"
                        "srcVar2"                       "$prev_timer"
                        "resultVar"                     "$speedo_value"
                }
                "Divide"
                {
                        "srcVar1"                       "$tmp"
                        "srcVar2"                       "$speedo_value"
                        "resultVar"                     "$speedo_value"
                }
                // if (timer > 0.0):
                // speedo = speedo_value
                "LessOrEqual"
                {
                        "srcVar1"                       "$timer"
                        "srcVar2"                       "$0"
                        "lessEqualVar"                  "$speedo"
                        "greaterVar"                    "$speedo_value"
                        "resultVar"                     "$speedo"
                }
                // if (timer >= 0.01):
                // prev_timer = timer
                "LessOrEqual"
                {
                        "srcVar1"                       "$timer_delay"
                        "srcVar2"                       "$timer"
                        "lessEqualVar"                  "$timer"
                        "greaterVar"                    "$prev_timer"
                        "resultVar"                     "$prev_timer"
                }
                // prev_total_dist = total_dist
                "LessOrEqual"
                {
                        "srcVar1"                       "$timer_delay"
                        "srcVar2"                       "$timer"
                        "lessEqualVar"                  "$total_dist"
                        "greaterVar"                    "$prev_total_dist"
                        "resultVar"                     "$prev_total_dist"
                }
                // total_dist = 0.0
                "LessOrEqual"
                {
                        "srcVar1"                       "$timer_delay"
                        "srcVar2"                       "$timer"
                        "lessEqualVar"                  "$0"
                        "greaterVar"                    "$total_dist"
                        "resultVar"                     "$total_dist"
                }
                // timer = 0.0
                "LessOrEqual"
                {
                        "srcVar1"                       "$timer_delay"
                        "srcVar2"                       "$timer"
                        "lessEqualVar"                  "$0"
                        "greaterVar"                    "$timer"
                        "resultVar"                     "$timer"
                }
                // if (dz <= 0.0009):
                // speedo = v
                "Abs"
                {
                        "srcVar1"                       "$dz"
                        "resultVar"                     "$tmp"
                }
                "LessOrEqual"
                {
                        "srcVar1"                       "$tmp"
                        "srcVar2"                       "$eps"
                        "lessEqualVar"                  "$v"
                        "greaterVar"                    "$speedo"
                        "resultVar"                     "$speedo"
                }
                // prev_x = x, prev_y = y, prev_z = z, prev_t = t, prev_v = v
                "Equals"
                {
                        "srcVar1"                       "$x"
                        "resultVar"                     "$prev_x"
                }
                "Equals"
                {
                        "srcVar1"                       "$y"
                        "resultVar"                     "$prev_y"
                }
                "Equals"
                {
                        "srcVar1"                       "$z"
                        "resultVar"                     "$prev_z"
                }
                "Equals"
                {
                        "srcVar1"                       "$time"
                        "resultVar"                     "$prev_t"
                }
                "Equals"
                {
                        "srcVar1"                       "$v"
                        "resultVar"                     "$prev_v"
                }
                // value = speedo + 0.1
                "Add"
                {
                        "srcVar1"                       "$speedo"
                        "srcVar2"                       "$0.1"
                        "resultVar"                     "$value"
                }
                // clamp speed
                "Clamp"
                {
                        "min"                           "0"
                        "max"                           "3500"
                        "srcVar1"                       "$value"
                        "resultVar"                     "$speed"
                }
                // ==============================================================
                // MARK: UPDATE FRAME
                // ==============================================================
                // change display value if updating
                // if(update==1){fullframe=speed}
                "LessOrEqual"
                {
                        "srcVar1"                       "$update"
                        "srcVar2"                       "$0"
                        "resultVar"                     "$fullframe"
                        "greaterVar"                    "$speed"
                        "lessEqualVar"                  "$fullframe"
                }
                "Equals"
                {
                        "srcVar1"                       "$fullframe"
                        "resultVar"                     "$frame"
                }
                // ==============================================================
                // MARK: ROUNDING
                // ==============================================================
                // if(round) temp = 5; else temp = 0
                "LessOrEqual"
                {
                        "srcVar1"                       "$round"
                        "srcVar2"                       "$0"
                        "resultVar"                     "$temp"
                        "greaterVar"                    "$5"
                        "lessEqualVar"                  "$0"
                }
                // speed = speed + temp
                "Add"
                {
                        "srcVar1"                       "$frame"
                        "srcVar2"                       "$temp"
                        "resultVar"                     "$frame"
                }
                // if(round) temp = 10; else temp = 1
                "LessOrEqual"
                {
                        "srcVar1"                       "$round"
                        "srcVar2"                       "$0"
                        "resultVar"                     "$temp"
                        "greaterVar"                    "$10"
                        "lessEqualVar"                  "$1"
                }
                // speed = speed / temp
                "Divide"
                {
                        "srcVar1"                       "$frame"
                        "srcVar2"                       "$temp"
                        "resultVar"                     "$frame"
                }
                // speed = parseInt(speed)
                "Int"
                {
                        "srcVar1"                       "$frame"
                        "resultVar"                     "$frame"
                }
                // speed = speed * temp
                "Multiply"
                {
                        "srcVar1"                       "$frame"
                        "srcVar2"                       "$temp"
                        "resultVar"                     "$frame"
                }
                // ==============================================================
                // MARK: COLORS
                // ==============================================================
                // BASE
                // default to white if none of the below conditions are met
                // --------------------------------------------------------------
                "Equals"
                {
                        "srcVar1"                       "$colorMain"
                        "resultVar"                     "$color"
                }
                // ==============================================================
                // CLOSE
                // if(speed>closeMin && speed<closeMax)
                // --------------------------------------------------------------
                "LessOrEqual"
                {
                        "srcVar1"                       "$frame"
                        "srcVar2"                       "$closeMin"
                        "resultVar"                     "$isAboveCloseMin"
                        "greaterVar"                    "$1"
                        "lessEqualVar"                  "$0"
                }
                "LessOrEqual"
                {
                        "srcVar1"                       "$frame"
                        "srcVar2"                       "$closeMax"
                        "resultVar"                     "$isBelowCloseMax"
                        "greaterVar"                    "$0"
                        "lessEqualVar"                  "$1"
                }
                "Multiply"
                {
                        "srcVar1"                       "$isAboveCloseMin"
                        "srcVar2"                       "$isBelowCloseMax"
                        "resultVar"                     "$isClose"
                }
                "LessOrEqual"
                {
                        "srcVar1"                       "$isClose"
                        "srcVar2"                       "$0"
                        "resultVar"                     "$color"
                        "greaterVar"                    "$colorClose"
                        "lessEqualVar"                  "$color"
                }
                // ==============================================================
                // GOOD
                // if(speed>goodMin && speed<goodMax)
                // --------------------------------------------------------------
                "LessOrEqual"
                {
                        "srcVar1"                       "$frame"
                        "srcVar2"                       "$goodMin"
                        "resultVar"                     "$isAboveGoodMin"
                        "greaterVar"                    "$1"
                        "lessEqualVar"                  "$0"
                }
                "LessOrEqual"
                {
                        "srcVar1"                       "$frame"
                        "srcVar2"                       "$goodMax"
                        "resultVar"                     "$isBelowGoodMax"
                        "greaterVar"                    "$0"
                        "lessEqualVar"                  "$1"
                }
                "Multiply"
                {
                        "srcVar1"                       "$isAboveGoodMin"
                        "srcVar2"                       "$isBelowGoodMax"
                        "resultVar"                     "$isGood"
                }
                "LessOrEqual"
                {
                        "srcVar1"                       "$isGood"
                        "srcVar2"                       "$0"
                        "resultVar"                     "$color"
                        "greaterVar"                    "$colorGood"
                        "lessEqualVar"                  "$color"
                }
                // ==============================================================
                // ABOVE
                // if(speed>aboveMin && speed<aboveMax)
                // --------------------------------------------------------------
                "LessOrEqual"
                {
                        "srcVar1"                       "$frame"
                        "srcVar2"                       "$closeMinB"
                        "resultVar"                     "$isAboveCloseMinB"
                        "greaterVar"                    "$1"
                        "lessEqualVar"                  "$0"
                }
                "LessOrEqual"
                {
                        "srcVar1"                       "$frame"
                        "srcVar2"                       "$closeMaxB"
                        "resultVar"                     "$isBelowCloseMaxB"
                        "greaterVar"                    "$0"
                        "lessEqualVar"                  "$1"
                }
                "Multiply"
                {
                        "srcVar1"                       "$isAboveCloseMinB"
                        "srcVar2"                       "$isBelowCloseMaxB"
                        "resultVar"                     "$isCloseB"
                }
                "LessOrEqual"
                {
                        "srcVar1"                       "$isCloseB"
                        "srcVar2"                       "$0"
                        "resultVar"                     "$color"
                        "greaterVar"                    "$colorClose"
                        "lessEqualVar"                  "$color"
                }
                // ==============================================================
                // MARK: SPEEDO RAINBOW
                // ==============================================================
                // RED
                // iRandRedBool = random(0,1)
                "UniformNoise"
                {
                        "minVal"                        "$0"
                        "maxVal"                        "$2"
                        "resultVar"                     "$iRandRedBool"
                }
                "Clamp"
                {
                        "min"                           "$0"
                        "max"                           "$1"
                        "srcVar1"                       "$rainbowRed"
                        "resultVar"                     "$rainbowRed"
                }
                "Add"
                {
                        "srcVar1"                       "$rainbowRed"
                        "srcVar2"                       "$diff"
                        "resultVar"                     "$rainbowRedI"
                }
                "Subtract"
                {
                        "srcVar1"                       "$rainbowRed"
                        "srcVar2"                       "$diff"
                        "resultVar"                     "$rainbowRedD"
                }
                // if(iRandRedBool){rainbowRed++} else {rainbowRed--}
                "LessOrEqual"
                {
                        "srcVar1"                       "$iRandRedBool"
                        "srcVar2"                       "$1"
                        "resultVar"                     "$rainbowRed"
                        "greaterVar"                    "$rainbowRedI"
                        "lessEqualVar"                  "$rainbowRedD"
                }
                "Equals"
                {
                        "srcVar1"                       "$rainbowRed"
                        "resultVar"                     "$rainbowColor[0]"
                }
                // GREEN
                // iRandGreenBool = random(0,1)
                "UniformNoise"
                {
                        "minVal"                        "$0"
                        "maxVal"                        "$2"
                        "resultVar"                     "$iRandGreenBool"
                }
                "Clamp"
                {
                        "min"                           "$0"
                        "max"                           "$1"
                        "srcVar1"                       "$rainbowGreen"
                        "resultVar"                     "$rainbowGreen"
                }
                "Add"
                {
                        "srcVar1"                       "$rainbowGreen"
                        "srcVar2"                       "$diff"
                        "resultVar"                     "$rainbowGreenI"
                }
                "Subtract"
                {
                        "srcVar1"                       "$rainbowGreen"
                        "srcVar2"                       "$diff"
                        "resultVar"                     "$rainbowGreenD"
                }
                // if(iRandGreenBool){rainbowGreen++} else {rainbowGreen--}
                "LessOrEqual"
                {
                        "srcVar1"                       "$iRandGreenBool"
                        "srcVar2"                       "$1"
                        "resultVar"                     "$rainbowGreen"
                        "greaterVar"                    "$rainbowGreenI"
                        "lessEqualVar"                  "$rainbowGreenD"
                }
                "Equals"
                {
                        "srcVar1"                       "$rainbowGreen"
                        "resultVar"                     "$rainbowColor[1]"
                }
                // BLUE
                // iRandBlueBool = random(0,1)
                "UniformNoise"
                {
                        "minVal"                        "$0"
                        "maxVal"                        "$2"
                        "resultVar"                     "$iRandBlueBool"
                }
                "Clamp"
                {
                        "min"                           "$0"
                        "max"                           "$1"
                        "srcVar1"                       "$rainbowBlue"
                        "resultVar"                     "$rainbowBlue"
                }
                "Add"
                {
                        "srcVar1"                       "$rainbowBlue"
                        "srcVar2"                       "$diff"
                        "resultVar"                     "$rainbowBlueI"
                }
                "Subtract"
                {
                        "srcVar1"                       "$rainbowBlue"
                        "srcVar2"                       "$diff"
                        "resultVar"                     "$rainbowBlueD"
                }
                // if(iRandBlueBool){rainbowBlue++} else {rainbowBlue--}
                "LessOrEqual"
                {
                        "srcVar1"                       "$iRandBlueBool"
                        "srcVar2"                       "$1"
                        "resultVar"                     "$rainbowBlue"
                        "greaterVar"                    "$rainbowBlueI"
                        "lessEqualVar"                  "$rainbowBlueD"
                }
                "Equals"
                {
                        "srcVar1"                       "$rainbowBlue"
                        "resultVar"                     "$rainbowColor[2]"
                }
                // ==============================================================
                // RAINBOW COLOR TOGGLE
                // ==============================================================
                "LessOrEqual"
                {
                        "srcVar1"                       "$enableRainbow"
                        "srcVar2"                       "$0"
                        "resultVar"                     "$color"
                        "greaterVar"                    "$rainbowColor"
                        "lessEqualVar"                  "$color"
                }
                // ==============================================================
                // MARK: DIGIT SEPERATION
                // ==============================================================
                // speed = frame;
                "SelectFirstIfNonZero"
                {
                        "srcVar1"                       "$debugSpeed"
                        "srcVar2"                       "$frame"
                        "resultVar"                     "$speed"
                }
                // "Equals"
                // {
                // "srcVar1"                       "$frame"
                // "resultVar"                     "$speed"
                // }
                // isLeft = !isRight
                "Subtract"
                {
                        "srcVar1"                       "$1"
                        "srcVar2"                       "$isLeft"
                        "resultVar"                     "$isRight"
                }
                /////////////////////////////////////////////////////////////
                // if (speed < 10000) is4Digit == 1;
                "LessOrEqual"
                {
                        "srcVar1"                       "$speed"
                        "srcVar2"                       "$9999"
                        "resultVar"                     "$is4Digit"
                        "lessEqualVar"                  "$1"
                        "greaterVar"                    "$0"
                }
                // if (speed < 1000) is3Digit == 1;
                "LessOrEqual"
                {
                        "srcVar1"                       "$speed"
                        "srcVar2"                       "$999"
                        "resultVar"                     "$is3Digit"
                        "lessEqualVar"                  "$1"
                        "greaterVar"                    "$0"
                }
                // if (speed < 100) is2Digit == 1;
                "LessOrEqual"
                {
                        "srcVar1"                       "$speed"
                        "srcVar2"                       "$99"
                        "resultVar"                     "$is2Digit"
                        "lessEqualVar"                  "$1"
                        "greaterVar"                    "$0"
                }
                // if (speed < 10) is1Digit == 1;
                "LessOrEqual"
                {
                        "srcVar1"                       "$speed"
                        "srcVar2"                       "$9"
                        "resultVar"                     "$is1Digit"
                        "lessEqualVar"                  "$1"
                        "greaterVar"                    "$0"
                }
                // if (speed > 99) leadingZero = 1;
                "LessOrEqual"
                {
                        "srcVar1"                       "$speed"
                        "srcVar2"                       "$99"
                        "resultVar"                     "$leadingZero"
                        "lessEqualVar"                  "$0"
                        "greaterVar"                    "$1"
                }
                "Multiply"
                {
                        "srcVar1"                       "$leadingZero"
                        "srcVar2"                       "$isRight"
                        "resultVar"                     "$leadingZero"
                }
                /////////////////////////////////////////////////////////////
                // if (is1Digit && isLeft) is1DigitAndLeft = 1;
                "Multiply"
                {
                        "srcVar1"                       "$is1Digit"
                        "srcVar2"                       "$isLeft"
                        "resultVar"                     "$is1DigitAndLeft"
                }
                // if (is1Digit && !isLeft) is1DigitAndRight = 1;
                "Multiply"
                {
                        "srcVar1"                       "$is1Digit"
                        "srcVar2"                       "$isRight"
                        "resultVar"                     "$is1DigitAndRight"
                }
                // if (is2Digit && isLeft) is2DigitAndLeft = 1;
                "Multiply"
                {
                        "srcVar1"                       "$is2Digit"
                        "srcVar2"                       "$isLeft"
                        "resultVar"                     "$is2DigitAndLeft"
                }
                // if (is2Digit && !isLeft) is2DigitAndRight = 1;
                "Multiply"
                {
                        "srcVar1"                       "$is2Digit"
                        "srcVar2"                       "$isRight"
                        "resultVar"                     "$is2DigitAndRight"
                }
                // if (is3Digit && isLeft) is3DigitAndLeft = 1;
                "Multiply"
                {
                        "srcVar1"                       "$is3Digit"
                        "srcVar2"                       "$isLeft"
                        "resultVar"                     "$is3DigitAndLeft"
                }
                // if (is3Digit && !isLeft) is3DigitAndRight = 1;
                "Multiply"
                {
                        "srcVar1"                       "$is3Digit"
                        "srcVar2"                       "$isRight"
                        "resultVar"                     "$is3DigitAndRight"
                }
                // if (is4Digit && isLeft) is4DigitAndLeft = 1;
                "Multiply"
                {
                        "srcVar1"                       "$is4Digit"
                        "srcVar2"                       "$isLeft"
                        "resultVar"                     "$is4DigitAndLeft"
                }
                // if (is4Digit && !isLeft) is4DigitAndRight = 1;
                "Multiply"
                {
                        "srcVar1"                       "$is4Digit"
                        "srcVar2"                       "$isRight"
                        "resultVar"                     "$is4DigitAndRight"
                }
                /////////////////////////////////////////////////////////////
                // 4 DIGITS
                // modulus = speed / 100;
                "Divide"
                {
                        "srcVar1"                       "$speed"
                        "srcVar2"                       "$100"
                        "resultVar"                     "$modulus"
                }
                // modulus = parseInt(modulus);
                "Int"
                {
                        "srcVar1"                       "$modulus"
                        "resultVar"                     "$modulus"
                }
                // if (isLeft) temp = 1; else temp = 100;
                "LessOrEqual"
                {
                        "srcVar1"                       "$isLeft"
                        "srcVar2"                       "$0"
                        "resultVar"                     "$temp"
                        "lessEqualVar"                  "$100"
                        "greaterVar"                    "$1"
                }
                // modulus = modulus * temp;
                "Multiply"
                {
                        "srcVar1"                       "$modulus"
                        "srcVar2"                       "$temp"
                        "resultVar"                     "$modulus"
                }
                // temp = speed - modulus;
                "Subtract"
                {
                        "srcVar1"                       "$speed"
                        "srcVar2"                       "$modulus"
                        "resultVar"                     "$temp"
                }
                // if (is4DigitAndLeft) frame = modulus;
                "LessOrEqual"
                {
                        "srcVar1"                       "$is4DigitAndLeft"
                        "srcVar2"                       "$0"
                        "resultVar"                     "$frame"
                        "lessEqualVar"                  "$frame"
                        "greaterVar"                    "$modulus"
                }
                // if (is4DigitAndRight) frame = temp;
                "LessOrEqual"
                {
                        "srcVar1"                       "$is4DigitAndRight"
                        "srcVar2"                       "$0"
                        "resultVar"                     "$frame"
                        "lessEqualVar"                  "$frame"
                        "greaterVar"                    "$temp"
                }
                "Add"
                {
                        "srcVar1"                       "$frame"
                        "srcVar2"                       "$100"
                        "resultVar"                     "$temp"
                }
                "LessOrEqual"
                {
                        "srcVar1"                       "$temp"
                        "srcVar2"                       "$109"
                        "resultVar"                     "$leadingZero"
                        "lessEqualVar"                  "$leadingZero"
                        "greaterVar"                    "$0"
                }
                "LessOrEqual"
                {
                        "srcVar1"                       "$leadingZero"
                        "srcVar2"                       "$0"
                        "resultVar"                     "$frame"
                        "lessEqualVar"                  "$frame"
                        "greaterVar"                    "$temp"
                }
                //// if (is4DigitAndLeft) offset = -1;
                "LessOrEqual"
                {
                        "srcVar1"                       "$is4DigitAndLeft"
                        "srcVar2"                       "$0"
                        "resultVar"                     "$offset"
                        "lessEqualVar"                  "$offset"
                        "greaterVar"                    "$1"
                }
                //// if (is4DigitAndRight) offset = 1;
                "LessOrEqual"
                {
                        "srcVar1"                       "$is4DigitAndRight"
                        "srcVar2"                       "$0"
                        "resultVar"                     "$offset"
                        "lessEqualVar"                  "$offset"
                        "greaterVar"                    "$-1"
                }
                /////////////////////////////////////////////////////////////
                // 3 DIGITS
                //// if (is3DigitAndLeft) offset = -1.5;
                "LessOrEqual"
                {
                        "srcVar1"                       "$is3DigitAndLeft"
                        "srcVar2"                       "$0"
                        "resultVar"                     "$offset"
                        "lessEqualVar"                  "$offset"
                        "greaterVar"                    "$1.5"
                }
                // if (is3DigitAndRight) offset = 0.5;
                "LessOrEqual"
                {
                        "srcVar1"                       "$is3DigitAndRight"
                        "srcVar2"                       "$0"
                        "resultVar"                     "$offset"
                        "lessEqualVar"                  "$offset"
                        "greaterVar"                    "$-0.5"
                }
                /////////////////////////////////////////////////////////////
                // 2 DIGITS
                // if (is2DigitAndRight) offset = 1;
                "LessOrEqual"
                {
                        "srcVar1"                       "$is2DigitAndRight"
                        "srcVar2"                       "$0"
                        "resultVar"                     "$offset"
                        "lessEqualVar"                  "$offset"
                        "greaterVar"                    "$0"
                }
                /////////////////////////////////////////////////////////////
                // 1 DIGIT
                // temp = frame <= 0
                "LessOrEqual"
                {
                        "srcVar1"                       "$frame"
                        "srcVar2"                       "$0"
                        "resultVar"                     "$temp"
                        "lessEqualVar"                  "$1"
                        "greaterVar"                    "$0"
                }
                "Multiply"
                {
                        "srcVar1"                       "$isLeft"
                        "srcVar2"                       "$temp"
                        "resultVar"                     "$temp"
                }
                "LessOrEqual"
                {
                        "srcVar1"                       "$temp"
                        "srcVar2"                       "$0"
                        "resultVar"                     "$frame"
                        "lessEqualVar"                  "$frame"
                        "greaterVar"                    "$blankFrame"
                }
                // if (is1DigitAndRight)offset = -0.5;
                "LessOrEqual"
                {
                        "srcVar1"                       "$is1DigitAndRight"
                        "srcVar2"                       "$0"
                        "resultVar"                     "$offset"
                        "lessEqualVar"                  "$offset"
                        "greaterVar"                    "$0.5"
                }
                /////////////////////////////////////////////////////////////
                // MARK: TRANSLATE
                "Divide"
                {
                        "srcVar1"                       "$width"
                        "srcVar2"                       "$totalWidth"
                        "resultVar"                     "$temp"
                }
                "Multiply"
                {
                        "srcVar1"                       "$temp"
                        "srcVar2"                       "$offset"
                        "resultVar"                     "$temp"
                }
                // apply offset
                "Equals"
                {
                        "srcVar1"                       "$temp"
                        "resultVar"                     "$translate[0]"
                }
                "TextureTransform"
                {
                        "centerVar"                     "$center"
                        "scaleVar"                      "$scale"
                        "rotateVar"                     "$rotate"
                        "translateVar"                  "$translate"
                        "resultVar"                     "$basetexturetransform"
                }
                /////////////////////////////////////////////////////////////
                // MARK: DEBUG
                // "LessOrEqual"
                // {
                // "srcVar1"                       "$isLeft"
                // "srcVar2"                       "$0"
                // "resultVar"                     "$color"
                // "lessEqualVar"                  "$color"
                // "greaterVar"                    "$colorClose"
                // }
                // "LessOrEqual"
                // {
                // "srcVar1"                       "$isRight"
                // "srcVar2"                       "$0"
                // "resultVar"                     "$color"
                // "lessEqualVar"                  "$color"
                // "greaterVar"                    "$colorGood"
                // }
                // safety to avoid 'nFrame is < 0!' error. this error is handled in c++ the same way
                "LessOrEqual"
                {
                        "srcVar1"                       "$frame"
                        "srcVar2"                       "$0"
                        "resultVar"                     "$frame"
                        "lessEqualVar"                  "$0"
                        "greaterVar"                    "$frame"
                }
        }
}