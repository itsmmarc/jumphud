"UnlitGeneric"
{
        // MARK: Variables
        // ==============================================================
        // DIGIT SEPERATION VARIABLES
        // ==============================================================
        "$debugSpeed"                           "0"
        "$blankFrame"                           "110"
        "$isLeft"                               "0"
        "$isRight"                              "0"
        "$offset"                               "0"
        "$modulus"                              "0"
        "$numDigits"                            "0"
        "$temp"                                 "0"
        "$is4Digit"                             "0"
        "$is3Digit"                             "0"
        "$is2Digit"                             "0"
        "$is1Digit"                             "0"
        "$is1DigitAndLeft"                      "0"
        "$is1DigitAndRight"                     "0"
        "$is2DigitAndLeft"                      "0"
        "$is2DigitAndRight"                     "0"
        "$is3DigitAndLeft"                      "0"
        "$is3DigitAndRight"                     "0"
        "$is4DigitAndLeft"                      "0"
        "$is4DigitAndRight"                     "0"
        "$leadingZero"                          "0"
        "$speed"                                "0"
        // ==============================================================
        // TEXTURE TRANSFORMATION VARIABLES
        // ==============================================================
        "$totalWidth"                           "256"
        "$width"                                "33"	// change depending on font
        "$center"                               "[0.5 0.5]"
        "$scale"                                "[1 1]"
        "$rotate"                               "0"
        "$translate"                            "[0.0 0.0]"
        // ==============================================================
        // UPDATE RATE VARIABLES
        // ==============================================================
        "$framerate"                            "30"
        "$fullframe"                            "0"
        "$time"                                 "0"
        "$oldtime"                              "0"
        "$interval"                             "0"
        "$const_interval"                       "0"
        "$update"                               "0"
        // ==============================================================
        // HEIGHTO CALCULATION VARIABLES
        // ==============================================================
        "$heighto"                              "0"
        "$const_eps"                            "0.009765625"
        "$pos"                                  "[ 0 0 0 ]"
        "$bottom"                               "0.0"
        "$top"                                  "0.0"
        "$upwards_timer"                        "0.0"
        "$downwards_timer"                      "0.0"
        "$standing_timer"                       "0.0"
        "$upwards_delay"                        "0.01"
        "$downwards_delay"                      "0.05"
        "$standing_delay"                       "0.1"
        "$t"                                    "0.0"
        "$prev_t"                               "0.0"
        "$x"                                    "0.0"
        "$y"                                    "0.0"
        "$z"                                    "0.0"
        "$prev_z"                               "0.0"
        "$prev_update_z"                        "0.0"
        "$tmp"                                  "0.0"
        "$tmp2"                                 "0.0"
        "$tmp3"                                 "0.0"
        "$gravity"                              "800.0"
        "$dt"                                   "0.0"
        "$dz"                                   "0.0"
        "$vertical_speed"                       "0.0"
        "$top_value"                            "0.0"
        //
        "$tickbuffer"                           "100"
        "$max_speed"                            "0"
        "$prev_vertical_speed"                  "0"
        "$useVelocity"                          "0"
        // ==============================================================
        // COLOR VARIABLES
        // ==============================================================
        "$colorMain"                            "{ 255 255 255 }"	// default color
        "$color"                                "$colorMain"
        // rainbow color vars
        "$enableRainbow"                        "0"
        "$rainbowColor"                         "[1 1 1]"
        "$iRandRedBool"                         "0"
        "$rainbowRed"                           "1.0"
        "$rainbowRedI"                          "0.0"
        "$rainbowRedD"                          "0.0"
        "$iRandGreenBool"                       "0"
        "$rainbowGreen"                         "1.0"
        "$rainbowGreenI"                        "0.0"
        "$rainbowGreenD"                        "0.0"
        "$iRandBlueBool"                        "0"
        "$rainbowBlue"                          "1.0"
        "$rainbowBlueI"                         "0.0"
        "$rainbowBlueD"                         "0.0"
        "$diff"                                 "0.004"	// 0.004
        "Proxies"
        {
                // ==============================================================
                // MARK: UPDATE RATE
                // ==============================================================
                // get const_interval
                // const_interval = 1/framerate
                "Divide"
                {
                        "srcVar1"                       "$1"
                        "srcVar2"                       "$framerate"
                        "resultVar"                     "$const_interval"
                }
                // Reset oldtime on new map
                // if(oldtime>time){oldtime=0}
                "LessOrEqual"
                {
                        "srcVar1"                       "$oldtime"
                        "srcVar2"                       "$time"
                        "resultVar"                     "$oldtime"
                        "greaterVar"                    "$0"
                        "lessEqualVar"                  "$oldtime"
                }
                // Get current time
                "CurrentTime"
                {
                        "resultVar"                     "$time"
                }
                // Calculate current interval
                // interval = time - oldtime
                "Subtract"
                {
                        "srcVar1"                       "$time"
                        "srcVar2"                       "$oldtime"
                        "resultVar"                     "$interval"
                }
                // Sets $update to 1 if it's time to update
                // if(interval>const_interval){update=1}
                "LessOrEqual"
                {
                        "srcVar1"                       "$interval"
                        "srcVar2"                       "$const_interval"
                        "resultVar"                     "$update"
                        "greaterVar"                    "$1"
                        "lessEqualVar"                  "$0"
                }
                // Save current time if updating
                // if(update==1){oldtime=time}
                "LessOrEqual"
                {
                        "srcVar1"                       "$update"
                        "srcVar2"                       "$0"
                        "resultVar"                     "$oldtime"
                        "greaterVar"                    "$time"
                        "lessEqualVar"                  "$oldtime"
                }
                // ==============================================================
                // MARK: HEIGHTO
                // ==============================================================
                // Get player position
                "PlayerPosition"
                {
                        "scale"                         "1"
                        "resultVar"                     "$pos"
                }
                "Clamp"
                {
                        "srcVar1"                       "$0"
                        "min"                           "$pos[0]"
                        "max"                           "$pos[0]"
                        "resultVar"                     "$x"
                }
                "Clamp"
                {
                        "srcVar1"                       "$0"
                        "min"                           "$pos[1]"
                        "max"                           "$pos[1]"
                        "resultVar"                     "$y"
                }
                "Clamp"
                {
                        "srcVar1"                       "$0"
                        "min"                           "$pos[2]"
                        "max"                           "$pos[2]"
                        "resultVar"                     "$z"
                }
                // Get game time
                "CurrentTime"
                {
                        "resultVar"                     "$t"
                }
                // increment timer only while player is moving vertically
                // dt = t - prev_t
                "Subtract"
                {
                        "srcVar1"                       "$t"
                        "srcVar2"                       "$prev_t"
                        "resultVar"                     "$dt"
                }
                // if prev_z != z:
                // upwards_timer += dt
                // downwards_timer += dt
                "Subtract"
                {
                        "srcVar1"                       "$prev_z"
                        "srcVar2"                       "$z"
                        "resultVar"                     "$tmp"
                }
                "Abs"
                {
                        "srcVar1"                       "$tmp"
                        "resultVar"                     "$tmp"
                }
                "Multiply"
                {
                        "srcVar1"                       "$tmp"
                        "srcVar2"                       "$-1"
                        "resultVar"                     "$tmp2"
                }
                "LessOrEqual"
                {
                        "srcVar1"                       "$tmp"
                        "srcVar2"                       "$tmp2"
                        "lessEqualVar"                  "$0"
                        "greaterVar"                    "$dt"
                        "resultVar"                     "$tmp2"
                }
                "Add"
                {
                        "srcVar1"                       "$upwards_timer"
                        "srcVar2"                       "$tmp2"
                        "resultVar"                     "$upwards_timer"
                }
                "Add"
                {
                        "srcVar1"                       "$downwards_timer"
                        "srcVar2"                       "$tmp2"
                        "resultVar"                     "$downwards_timer"
                }
                // if abs(prev_z - z) <= eps
                // standing_timer += dt
                "Multiply"
                {
                        "srcVar1"                       "$standing_timer"
                        "srcVar2"                       "$-1"
                        "resultVar"                     "$tmp2"
                }
                "LessOrEqual"
                {
                        "srcVar1"                       "$tmp"
                        "srcVar2"                       "$const_eps"
                        "lessEqualVar"                  "$dt"
                        "greaterVar"                    "$tmp2"
                        "resultVar"                     "$tmp3"
                }
                "Add"
                {
                        "srcVar1"                       "$standing_timer"
                        "srcVar2"                       "$tmp3"
                        "resultVar"                     "$standing_timer"
                }
                // reset upwards_timer
                // if prev_z > z:
                // upwards_timer = 0
                "LessOrEqual"
                {
                        "srcVar1"                       "$prev_z"
                        "srcVar2"                       "$z"
                        "lessEqualVar"                  "$upwards_timer"
                        "greaterVar"                    "$0"
                        "resultVar"                     "$upwards_timer"
                }
                // prev_update_z = z
                "LessOrEqual"
                {
                        "srcVar1"                       "$prev_z"
                        "srcVar2"                       "$z"
                        "lessEqualVar"                  "$prev_update_z"
                        "greaterVar"                    "$z"
                        "resultVar"                     "$prev_update_z"
                }
                // reset downwards_timer
                // if prev_z < z:
                // downwards_timer = 0
                "LessOrEqual"
                {
                        "srcVar1"                       "$z"
                        "srcVar2"                       "$prev_z"
                        "lessEqualVar"                  "$downwards_timer"
                        "greaterVar"                    "$0"
                        "resultVar"                     "$downwards_timer"
                }
                // top calculation
                // dz = z - prev_update_z
                "Subtract"
                {
                        "srcVar1"                       "$z"
                        "srcVar2"                       "$prev_update_z"
                        "resultVar"                     "$dz"
                }
                // vertical_speed = dz / upwards_timer - g*upwards_timer/2
                "Multiply"
                {
                        "srcVar1"                       "$gravity"
                        "srcVar2"                       "$upwards_timer"
                        "resultVar"                     "$tmp"
                }
                "Divide"
                {
                        "srcVar1"                       "$tmp"
                        "srcVar2"                       "$2"
                        "resultVar"                     "$tmp"
                }
                "Divide"
                {
                        "srcVar1"                       "$dz"
                        "srcVar2"                       "$upwards_timer"
                        "resultVar"                     "$tmp2"
                }
                "Subtract"
                {
                        "srcVar1"                       "$tmp2"
                        "srcVar2"                       "$tmp"
                        "resultVar"                     "$vertical_speed"
                }
                // top_value = z + vertical_speed^2 / (2 * g)
                "Multiply"
                {
                        "srcVar1"                       "$gravity"
                        "srcVar2"                       "$2"
                        "resultVar"                     "$tmp"
                }
                "Multiply"
                {
                        "srcVar1"                       "$vertical_speed"
                        "srcVar2"                       "$vertical_speed"
                        "resultVar"                     "$tmp2"
                }
                "Divide"
                {
                        "srcVar1"                       "$tmp2"
                        "srcVar2"                       "$tmp"
                        "resultVar"                     "$tmp"
                }
                "Add"
                {
                        "srcVar1"                       "$z"
                        "srcVar2"                       "$tmp"
                        "resultVar"                     "$top_value"
                }
                // Trigger top update
                // if upwards_timer >= 0.1:
                // top = top_value
                "LessOrEqual"
                {
                        "srcVar1"                       "$upwards_delay"
                        "srcVar2"                       "$upwards_timer"
                        "lessEqualVar"                  "$top_value"
                        "greaterVar"                    "$top"
                        "resultVar"                     "$top"
                }
                // Reset timer
                // prev_update_z = z
                "LessOrEqual"
                {
                        "srcVar1"                       "$upwards_delay"
                        "srcVar2"                       "$upwards_timer"
                        "lessEqualVar"                  "$z"
                        "greaterVar"                    "$prev_update_z"
                        "resultVar"                     "$prev_update_z"
                }
                // upwards_timer = 0
                "LessOrEqual"
                {
                        "srcVar1"                       "$upwards_delay"
                        "srcVar2"                       "$upwards_timer"
                        "lessEqualVar"                  "$0"
                        "greaterVar"                    "$upwards_timer"
                        "resultVar"                     "$upwards_timer"
                }
                // Trigger bottom update
                // if downwards_timer >= 0.1:
                // bottom = z
                "LessOrEqual"
                {
                        "srcVar1"                       "$downwards_delay"
                        "srcVar2"                       "$downwards_timer"
                        "lessEqualVar"                  "$z"
                        "greaterVar"                    "$bottom"
                        "resultVar"                     "$bottom"
                }
                // if standing_timer >= 0.1:
                // trigger bottom update
                "LessOrEqual"
                {
                        "srcVar1"                       "$standing_delay"
                        "srcVar2"                       "$standing_timer"
                        "lessEqualVar"                  "$z"
                        "greaterVar"                    "$bottom"
                        "resultVar"                     "$bottom"
                }
                // reset upwards timer
                "LessOrEqual"
                {
                        "srcVar1"                       "$standing_delay"
                        "srcVar2"                       "$standing_timer"
                        "lessEqualVar"                  "$z"
                        "greaterVar"                    "$prev_update_z"
                        "resultVar"                     "$prev_update_z"
                }
                "LessOrEqual"
                {
                        "srcVar1"                       "$standing_delay"
                        "srcVar2"                       "$standing_timer"
                        "lessEqualVar"                  "$0"
                        "greaterVar"                    "$upwards_timer"
                        "resultVar"                     "$upwards_timer"
                }
                // reset downwards timer
                "LessOrEqual"
                {
                        "srcVar1"                       "$standing_delay"
                        "srcVar2"                       "$standing_timer"
                        "lessEqualVar"                  "$0"
                        "greaterVar"                    "$downwards_timer"
                        "resultVar"                     "$downwards_timer"
                }
                // prev_z = z
                // prev_t = t
                "Equals"
                {
                        "srcVar1"                       "$z"
                        "resultVar"                     "$prev_z"
                }
                "Equals"
                {
                        "srcVar1"                       "$t"
                        "resultVar"                     "$prev_t"
                }
                // display (top - bottom + 10)
                "Subtract"
                {
                        "srcVar1"                       "$top"
                        "srcVar2"                       "$bottom"
                        "resultVar"                     "$tmp"
                }
                "Add"
                {
                        "srcVar1"                       "$tmp"
                        "srcVar2"                       "$10"
                        "resultVar"                     "$heighto"
                }
                "Clamp"
                {
                        "srcVar1"                       "$heighto"
                        "min"                           "$0"
                        "max"                           "$10000"
                        "resultVar"                     "$heighto"
                }
                "LessOrEqual"
                {
                        "srcVar1"                       "$heighto"
                        "srcVar2"                       "$9999"
                        "resultVar"                     "$heighto"
                        "greaterVar"                    "$0"
                        "lessEqualVar"                  "$heighto"
                }
                // ==============================================================
                // MARK: UPDATE FRAME
                // ==============================================================
                // change display value if updating
                // if(update==1){fullframe=heighto}
                "LessOrEqual"
                {
                        "srcVar1"                       "$update"
                        "srcVar2"                       "$0"
                        "resultVar"                     "$fullframe"
                        "greaterVar"                    "$heighto"
                        "lessEqualVar"                  "$fullframe"
                }
                "Equals"
                {
                        "srcVar1"                       "$fullframe"
                        "resultVar"                     "$frame"
                }
                // ==============================================================
                // MARK: ROUNDING
                // ==============================================================
                // if(round) temp = 5; else temp = 0
                "LessOrEqual"
                {
                        "srcVar1"                       "$round"
                        "srcVar2"                       "$0"
                        "resultVar"                     "$temp"
                        "greaterVar"                    "$5"
                        "lessEqualVar"                  "$0"
                }
                // speed = speed + temp
                "Add"
                {
                        "srcVar1"                       "$frame"
                        "srcVar2"                       "$temp"
                        "resultVar"                     "$frame"
                }
                // if(round) temp = 10; else temp = 1
                "LessOrEqual"
                {
                        "srcVar1"                       "$round"
                        "srcVar2"                       "$0"
                        "resultVar"                     "$temp"
                        "greaterVar"                    "$10"
                        "lessEqualVar"                  "$1"
                }
                // speed = speed / temp
                "Divide"
                {
                        "srcVar1"                       "$frame"
                        "srcVar2"                       "$temp"
                        "resultVar"                     "$frame"
                }
                // speed = parseInt(speed)
                "Int"
                {
                        "srcVar1"                       "$frame"
                        "resultVar"                     "$frame"
                }
                // speed = speed * temp
                "Multiply"
                {
                        "srcVar1"                       "$frame"
                        "srcVar2"                       "$temp"
                        "resultVar"                     "$frame"
                }
                // ==============================================================
                // MARK: COLORS
                // ==============================================================
                // BASE
                // default to white if none of the below conditions are met
                // --------------------------------------------------------------
                "Equals"
                {
                        "srcVar1"                       "$colorMain"
                        "resultVar"                     "$color"
                }
                // ==============================================================
                // DOUBLE
                // if(speed>doubleMin && speed<doubleMax)
                // --------------------------------------------------------------
                "LessOrEqual"
                {
                        "srcVar1"                       "$frame"
                        "srcVar2"                       "$doubleMin"
                        "resultVar"                     "$isAboveDoubleMin"
                        "greaterVar"                    "$1"
                        "lessEqualVar"                  "$0"
                }
                "LessOrEqual"
                {
                        "srcVar1"                       "$frame"
                        "srcVar2"                       "$doubleMax"
                        "resultVar"                     "$isBelowDoubleMax"
                        "greaterVar"                    "$0"
                        "lessEqualVar"                  "$1"
                }
                "Multiply"
                {
                        "srcVar1"                       "$isAboveDoubleMin"
                        "srcVar2"                       "$isBelowDoubleMax"
                        "resultVar"                     "$isDouble"
                }
                "LessOrEqual"
                {
                        "srcVar1"                       "$isDouble"
                        "srcVar2"                       "$0"
                        "resultVar"                     "$color"
                        "greaterVar"                    "$colorClose"
                        "lessEqualVar"                  "$color"
                }
                // ==============================================================
                // TRIPLE
                // if(speed>tripleMin && speed<tripleMax)
                // --------------------------------------------------------------
                "LessOrEqual"
                {
                        "srcVar1"                       "$frame"
                        "srcVar2"                       "$tripleMin"
                        "resultVar"                     "$isAboveTripleMin"
                        "greaterVar"                    "$1"
                        "lessEqualVar"                  "$0"
                }
                "LessOrEqual"
                {
                        "srcVar1"                       "$frame"
                        "srcVar2"                       "$tripleMax"
                        "resultVar"                     "$isBelowTripleMax"
                        "greaterVar"                    "$0"
                        "lessEqualVar"                  "$1"
                }
                "Multiply"
                {
                        "srcVar1"                       "$isAboveTripleMin"
                        "srcVar2"                       "$isBelowTripleMax"
                        "resultVar"                     "$isTriple"
                }
                "LessOrEqual"
                {
                        "srcVar1"                       "$isTriple"
                        "srcVar2"                       "$0"
                        "resultVar"                     "$color"
                        "greaterVar"                    "$colorGood"
                        "lessEqualVar"                  "$color"
                }
                // ==============================================================
                // ABOVE
                // if(speed>aboveMin && speed<aboveMax)
                // --------------------------------------------------------------
                "LessOrEqual"
                {
                        "srcVar1"                       "$frame"
                        "srcVar2"                       "$maxVelMin"
                        "resultVar"                     "$isAboveMaxVelMin"
                        "greaterVar"                    "$1"
                        "lessEqualVar"                  "$0"
                }
                "LessOrEqual"
                {
                        "srcVar1"                       "$isAboveMaxVelMin"
                        "srcVar2"                       "$0"
                        "resultVar"                     "$color"
                        "greaterVar"                    "$colorMaxVel"
                        "lessEqualVar"                  "$color"
                }
                // ==============================================================
                // VELOCITY HEIGHTO
                // ==============================================================
                // if(vertical_speed > (prev_vertical_speed + 30)) { max_speed = vertical_speed }
                "Add"
                {
                        "srcVar1"                       "$prev_vertical_speed"
                        "srcVar2"                       "$tickbuffer"
                        "resultVar"                     "$tmp"
                }
                "LessOrEqual"
                {
                        "srcVar1"                       "$vertical_speed"
                        "srcVar2"                       "$tmp"
                        "resultVar"                     "$max_speed"
                        "greaterVar"                    "$vertical_speed"
                        "lessEqualVar"                  "$max_speed"
                }
                // if(vertical_speed <= (prev_vertical_speed - 30)) { max_speed = vertical_speed }
                "Subtract"
                {
                        "srcVar1"                       "$prev_vertical_speed"
                        "srcVar2"                       "$tickbuffer"
                        "resultVar"                     "$tmp"
                }
                "LessOrEqual"
                {
                        "srcVar1"                       "$vertical_speed"
                        "srcVar2"                       "$tmp"
                        "resultVar"                     "$max_speed"
                        "greaterVar"                    "$max_speed"
                        "lessEqualVar"                  "$vertical_speed"
                }
                // prev_vertical_speed = vertical_speed
                "Equals"
                {
                        "srcVar1"                       "$vertical_speed"
                        "resultVar"                     "$prev_vertical_speed"
                }
                // frame = max_speed
                "LessOrEqual"
                {
                        "srcVar1"                       "$useVelocity"
                        "srcVar2"                       "$0"
                        "greaterVar"                    "$max_speed"
                        "lessEqualVar"                  "$frame"
                        "resultVar"                     "$frame"
                }
                // ==============================================================
                // MARK: SPEEDO RAINBOW
                // ==============================================================
                // RED
                // iRandRedBool = random(0,1)
                "UniformNoise"
                {
                        "minVal"                        "$0"
                        "maxVal"                        "$2"
                        "resultVar"                     "$iRandRedBool"
                }
                "Clamp"
                {
                        "min"                           "$0"
                        "max"                           "$1"
                        "srcVar1"                       "$rainbowRed"
                        "resultVar"                     "$rainbowRed"
                }
                "Add"
                {
                        "srcVar1"                       "$rainbowRed"
                        "srcVar2"                       "$diff"
                        "resultVar"                     "$rainbowRedI"
                }
                "Subtract"
                {
                        "srcVar1"                       "$rainbowRed"
                        "srcVar2"                       "$diff"
                        "resultVar"                     "$rainbowRedD"
                }
                // if(iRandRedBool){rainbowRed++} else {rainbowRed--}
                "LessOrEqual"
                {
                        "srcVar1"                       "$iRandRedBool"
                        "srcVar2"                       "$1"
                        "resultVar"                     "$rainbowRed"
                        "greaterVar"                    "$rainbowRedI"
                        "lessEqualVar"                  "$rainbowRedD"
                }
                "Equals"
                {
                        "srcVar1"                       "$rainbowRed"
                        "resultVar"                     "$rainbowColor[0]"
                }
                // GREEN
                // iRandGreenBool = random(0,1)
                "UniformNoise"
                {
                        "minVal"                        "$0"
                        "maxVal"                        "$2"
                        "resultVar"                     "$iRandGreenBool"
                }
                "Clamp"
                {
                        "min"                           "$0"
                        "max"                           "$1"
                        "srcVar1"                       "$rainbowGreen"
                        "resultVar"                     "$rainbowGreen"
                }
                "Add"
                {
                        "srcVar1"                       "$rainbowGreen"
                        "srcVar2"                       "$diff"
                        "resultVar"                     "$rainbowGreenI"
                }
                "Subtract"
                {
                        "srcVar1"                       "$rainbowGreen"
                        "srcVar2"                       "$diff"
                        "resultVar"                     "$rainbowGreenD"
                }
                // if(iRandGreenBool){rainbowGreen++} else {rainbowGreen--}
                "LessOrEqual"
                {
                        "srcVar1"                       "$iRandGreenBool"
                        "srcVar2"                       "$1"
                        "resultVar"                     "$rainbowGreen"
                        "greaterVar"                    "$rainbowGreenI"
                        "lessEqualVar"                  "$rainbowGreenD"
                }
                "Equals"
                {
                        "srcVar1"                       "$rainbowGreen"
                        "resultVar"                     "$rainbowColor[1]"
                }
                // BLUE
                // iRandBlueBool = random(0,1)
                "UniformNoise"
                {
                        "minVal"                        "$0"
                        "maxVal"                        "$2"
                        "resultVar"                     "$iRandBlueBool"
                }
                "Clamp"
                {
                        "min"                           "$0"
                        "max"                           "$1"
                        "srcVar1"                       "$rainbowBlue"
                        "resultVar"                     "$rainbowBlue"
                }
                "Add"
                {
                        "srcVar1"                       "$rainbowBlue"
                        "srcVar2"                       "$diff"
                        "resultVar"                     "$rainbowBlueI"
                }
                "Subtract"
                {
                        "srcVar1"                       "$rainbowBlue"
                        "srcVar2"                       "$diff"
                        "resultVar"                     "$rainbowBlueD"
                }
                // if(iRandBlueBool){rainbowBlue++} else {rainbowBlue--}
                "LessOrEqual"
                {
                        "srcVar1"                       "$iRandBlueBool"
                        "srcVar2"                       "$1"
                        "resultVar"                     "$rainbowBlue"
                        "greaterVar"                    "$rainbowBlueI"
                        "lessEqualVar"                  "$rainbowBlueD"
                }
                "Equals"
                {
                        "srcVar1"                       "$rainbowBlue"
                        "resultVar"                     "$rainbowColor[2]"
                }
                // ==============================================================
                // RAINBOW COLOR TOGGLE
                // ==============================================================
                "LessOrEqual"
                {
                        "srcVar1"                       "$enableRainbow"
                        "srcVar2"                       "$0"
                        "resultVar"                     "$color"
                        "greaterVar"                    "$rainbowColor"
                        "lessEqualVar"                  "$color"
                }
                // ==============================================================
                // MARK: DIGIT SEPERATION
                // ==============================================================
                // speed = frame;
                "SelectFirstIfNonZero"
                {
                        "srcVar1"                       "$debugSpeed"
                        "srcVar2"                       "$frame"
                        "resultVar"                     "$speed"
                }
                // "Equals"
                // {
                // "srcVar1"                       "$frame"
                // "resultVar"                     "$speed"
                // }
                // isLeft = !isRight
                "Subtract"
                {
                        "srcVar1"                       "$1"
                        "srcVar2"                       "$isLeft"
                        "resultVar"                     "$isRight"
                }
                /////////////////////////////////////////////////////////////
                // if (speed < 10000) is4Digit == 1;
                "LessOrEqual"
                {
                        "srcVar1"                       "$speed"
                        "srcVar2"                       "$9999"
                        "resultVar"                     "$is4Digit"
                        "lessEqualVar"                  "$1"
                        "greaterVar"                    "$0"
                }
                // if (speed < 1000) is3Digit == 1;
                "LessOrEqual"
                {
                        "srcVar1"                       "$speed"
                        "srcVar2"                       "$999"
                        "resultVar"                     "$is3Digit"
                        "lessEqualVar"                  "$1"
                        "greaterVar"                    "$0"
                }
                // if (speed < 100) is2Digit == 1;
                "LessOrEqual"
                {
                        "srcVar1"                       "$speed"
                        "srcVar2"                       "$99"
                        "resultVar"                     "$is2Digit"
                        "lessEqualVar"                  "$1"
                        "greaterVar"                    "$0"
                }
                // if (speed < 10) is1Digit == 1;
                "LessOrEqual"
                {
                        "srcVar1"                       "$speed"
                        "srcVar2"                       "$9"
                        "resultVar"                     "$is1Digit"
                        "lessEqualVar"                  "$1"
                        "greaterVar"                    "$0"
                }
                // if (speed > 99) leadingZero = 1;
                "LessOrEqual"
                {
                        "srcVar1"                       "$speed"
                        "srcVar2"                       "$99"
                        "resultVar"                     "$leadingZero"
                        "lessEqualVar"                  "$0"
                        "greaterVar"                    "$1"
                }
                "Multiply"
                {
                        "srcVar1"                       "$leadingZero"
                        "srcVar2"                       "$isRight"
                        "resultVar"                     "$leadingZero"
                }
                /////////////////////////////////////////////////////////////
                // if (is1Digit && isLeft) is1DigitAndLeft = 1;
                "Multiply"
                {
                        "srcVar1"                       "$is1Digit"
                        "srcVar2"                       "$isLeft"
                        "resultVar"                     "$is1DigitAndLeft"
                }
                // if (is1Digit && !isLeft) is1DigitAndRight = 1;
                "Multiply"
                {
                        "srcVar1"                       "$is1Digit"
                        "srcVar2"                       "$isRight"
                        "resultVar"                     "$is1DigitAndRight"
                }
                // if (is2Digit && isLeft) is2DigitAndLeft = 1;
                "Multiply"
                {
                        "srcVar1"                       "$is2Digit"
                        "srcVar2"                       "$isLeft"
                        "resultVar"                     "$is2DigitAndLeft"
                }
                // if (is2Digit && !isLeft) is2DigitAndRight = 1;
                "Multiply"
                {
                        "srcVar1"                       "$is2Digit"
                        "srcVar2"                       "$isRight"
                        "resultVar"                     "$is2DigitAndRight"
                }
                // if (is3Digit && isLeft) is3DigitAndLeft = 1;
                "Multiply"
                {
                        "srcVar1"                       "$is3Digit"
                        "srcVar2"                       "$isLeft"
                        "resultVar"                     "$is3DigitAndLeft"
                }
                // if (is3Digit && !isLeft) is3DigitAndRight = 1;
                "Multiply"
                {
                        "srcVar1"                       "$is3Digit"
                        "srcVar2"                       "$isRight"
                        "resultVar"                     "$is3DigitAndRight"
                }
                // if (is4Digit && isLeft) is4DigitAndLeft = 1;
                "Multiply"
                {
                        "srcVar1"                       "$is4Digit"
                        "srcVar2"                       "$isLeft"
                        "resultVar"                     "$is4DigitAndLeft"
                }
                // if (is4Digit && !isLeft) is4DigitAndRight = 1;
                "Multiply"
                {
                        "srcVar1"                       "$is4Digit"
                        "srcVar2"                       "$isRight"
                        "resultVar"                     "$is4DigitAndRight"
                }
                /////////////////////////////////////////////////////////////
                // 4 DIGITS
                // modulus = speed / 100;
                "Divide"
                {
                        "srcVar1"                       "$speed"
                        "srcVar2"                       "$100"
                        "resultVar"                     "$modulus"
                }
                // modulus = parseInt(modulus);
                "Int"
                {
                        "srcVar1"                       "$modulus"
                        "resultVar"                     "$modulus"
                }
                // if (isLeft) temp = 1; else temp = 100;
                "LessOrEqual"
                {
                        "srcVar1"                       "$isLeft"
                        "srcVar2"                       "$0"
                        "resultVar"                     "$temp"
                        "lessEqualVar"                  "$100"
                        "greaterVar"                    "$1"
                }
                // modulus = modulus * temp;
                "Multiply"
                {
                        "srcVar1"                       "$modulus"
                        "srcVar2"                       "$temp"
                        "resultVar"                     "$modulus"
                }
                // temp = speed - modulus;
                "Subtract"
                {
                        "srcVar1"                       "$speed"
                        "srcVar2"                       "$modulus"
                        "resultVar"                     "$temp"
                }
                // if (is4DigitAndLeft) frame = modulus;
                "LessOrEqual"
                {
                        "srcVar1"                       "$is4DigitAndLeft"
                        "srcVar2"                       "$0"
                        "resultVar"                     "$frame"
                        "lessEqualVar"                  "$frame"
                        "greaterVar"                    "$modulus"
                }
                // if (is4DigitAndRight) frame = temp;
                "LessOrEqual"
                {
                        "srcVar1"                       "$is4DigitAndRight"
                        "srcVar2"                       "$0"
                        "resultVar"                     "$frame"
                        "lessEqualVar"                  "$frame"
                        "greaterVar"                    "$temp"
                }
                "Add"
                {
                        "srcVar1"                       "$frame"
                        "srcVar2"                       "$100"
                        "resultVar"                     "$temp"
                }
                "LessOrEqual"
                {
                        "srcVar1"                       "$temp"
                        "srcVar2"                       "$109"
                        "resultVar"                     "$leadingZero"
                        "lessEqualVar"                  "$leadingZero"
                        "greaterVar"                    "$0"
                }
                "LessOrEqual"
                {
                        "srcVar1"                       "$leadingZero"
                        "srcVar2"                       "$0"
                        "resultVar"                     "$frame"
                        "lessEqualVar"                  "$frame"
                        "greaterVar"                    "$temp"
                }
                //// if (is4DigitAndLeft) offset = -1;
                "LessOrEqual"
                {
                        "srcVar1"                       "$is4DigitAndLeft"
                        "srcVar2"                       "$0"
                        "resultVar"                     "$offset"
                        "lessEqualVar"                  "$offset"
                        "greaterVar"                    "$1"
                }
                //// if (is4DigitAndRight) offset = 1;
                "LessOrEqual"
                {
                        "srcVar1"                       "$is4DigitAndRight"
                        "srcVar2"                       "$0"
                        "resultVar"                     "$offset"
                        "lessEqualVar"                  "$offset"
                        "greaterVar"                    "$-1"
                }
                /////////////////////////////////////////////////////////////
                // 3 DIGITS
                //// if (is3DigitAndLeft) offset = -1.5;
                "LessOrEqual"
                {
                        "srcVar1"                       "$is3DigitAndLeft"
                        "srcVar2"                       "$0"
                        "resultVar"                     "$offset"
                        "lessEqualVar"                  "$offset"
                        "greaterVar"                    "$1.5"
                }
                // if (is3DigitAndRight) offset = 0.5;
                "LessOrEqual"
                {
                        "srcVar1"                       "$is3DigitAndRight"
                        "srcVar2"                       "$0"
                        "resultVar"                     "$offset"
                        "lessEqualVar"                  "$offset"
                        "greaterVar"                    "$-0.5"
                }
                /////////////////////////////////////////////////////////////
                // 2 DIGITS
                // if (is2DigitAndRight) offset = 1;
                "LessOrEqual"
                {
                        "srcVar1"                       "$is2DigitAndRight"
                        "srcVar2"                       "$0"
                        "resultVar"                     "$offset"
                        "lessEqualVar"                  "$offset"
                        "greaterVar"                    "$0"
                }
                /////////////////////////////////////////////////////////////
                // 1 DIGIT
                // temp = frame <= 0
                "LessOrEqual"
                {
                        "srcVar1"                       "$frame"
                        "srcVar2"                       "$0"
                        "resultVar"                     "$temp"
                        "lessEqualVar"                  "$1"
                        "greaterVar"                    "$0"
                }
                "Multiply"
                {
                        "srcVar1"                       "$isLeft"
                        "srcVar2"                       "$temp"
                        "resultVar"                     "$temp"
                }
                "LessOrEqual"
                {
                        "srcVar1"                       "$temp"
                        "srcVar2"                       "$0"
                        "resultVar"                     "$frame"
                        "lessEqualVar"                  "$frame"
                        "greaterVar"                    "$blankFrame"
                }
                // if (is1DigitAndRight)offset = -0.5;
                "LessOrEqual"
                {
                        "srcVar1"                       "$is1DigitAndRight"
                        "srcVar2"                       "$0"
                        "resultVar"                     "$offset"
                        "lessEqualVar"                  "$offset"
                        "greaterVar"                    "$0.5"
                }
                /////////////////////////////////////////////////////////////
                // MARK: TRANSLATE
                "Divide"
                {
                        "srcVar1"                       "$width"
                        "srcVar2"                       "$totalWidth"
                        "resultVar"                     "$temp"
                }
                "Multiply"
                {
                        "srcVar1"                       "$temp"
                        "srcVar2"                       "$offset"
                        "resultVar"                     "$temp"
                }
                // apply offset
                "Equals"
                {
                        "srcVar1"                       "$temp"
                        "resultVar"                     "$translate[0]"
                }
                "TextureTransform"
                {
                        "centerVar"                     "$center"
                        "scaleVar"                      "$scale"
                        "rotateVar"                     "$rotate"
                        "translateVar"                  "$translate"
                        "resultVar"                     "$basetexturetransform"
                }
                /////////////////////////////////////////////////////////////
                // MARK: DEBUG
                // "LessOrEqual"
                // {
                // "srcVar1"                       "$isLeft"
                // "srcVar2"                       "$0"
                // "resultVar"                     "$color"
                // "lessEqualVar"                  "$color"
                // "greaterVar"                    "$colorClose"
