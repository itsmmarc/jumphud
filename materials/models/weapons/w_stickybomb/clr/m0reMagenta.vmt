"VertexLitGeneric"
{
        "$baseTexture"                  "models\weapons\w_stickybomb/w_stickybomb_white"
        "$color2"                       "{ 255 0 127 }"
        "$selfillumtint"                "{ 255 0 127 }"
        ">=DX90"
        {
                "$baseTexture"                  "models\weapons\w_stickybomb/w_stickybomb_white"
                "$selfillummask"                "models\weapons\w_stickybomb/w_stickybomb_selfillum"
        }
        // Use redundant self-illum in base alpha on Pre DX9 hardware
        "<DX90"
        {
                "$baseTexture"                  "models\weapons\w_stickybomb/w_stickybomb_white"
        }
        "$sineState"                    "0.25"
        "$sineOffset"                   "0"
        "Proxies"
        {
                "EntityRandom"
                {
                        "resultVar"                     "$sineOffset"
                }
                "Sine"
                {
                        "resultVar"                     "$selfillumtint"
                        "timeoffset"                    "$sineOffset"
                        "sinemin"                       ".1"
                        "sinemax"                       "2.00"
                        "sineperiod"                    "0.50"
                }
        }
}