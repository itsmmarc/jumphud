#base "../../../cfg/jumphud/jh_spraypaint_size.txt"
#base spraypaint_size_medium.vmt
#base ../vgui/replay/thumbnails/s/colors/$colorMain/m0reWhite.vmt

"LightMappedGeneric"
{
    "$basetexture" "sprays/spraypaint"
    "$decal" 1
	"$translucent" 1
	"$vertexcolor" "1"
	"$vertexalpha" "1"

    $color "{255 255 255}"

    Proxies
    {
        Equals {srcVar1 $colorMain resultVar $color}
    }
}
