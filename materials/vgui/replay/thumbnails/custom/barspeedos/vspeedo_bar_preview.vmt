// ==============================================================
// TRANSPARENCY
// --------------------------------------------------------------
"#base"         "../../../../../../../cfg/jumphud/jh_barspeedo_transparency.txt"
// ==============================================================
// TEXTURE
// --------------------------------------------------------------
"#base"         "../../../../../speedo/bar/bar_h.vmt"
// ==============================================================
// COLORS
// --------------------------------------------------------------
"#base"         "../../../../../speedo/colors/ranges/vspeedo_demo.vmt"
"#base"         "../../../../../../../../cfg/jumphud/jh_bspeedo_dynclr_main.txt"
"#base"         "../../../../../../../../cfg/jumphud/jh_bspeedo_dynclr_close.txt"
"#base"         "../../../../../../../../cfg/jumphud/jh_bspeedo_dynclr_good.txt"
"#base"         "../../../../../speedo/colors/speedo_colors_default.vmt"
"#base"         "../../../../../speedo/colors/ranges/conditionals.vmt"
// ==============================================================
// CONSTANTS
// --------------------------------------------------------------
"#base"         "../../../../../speedo/const/constantNumbers.vmt"
"UnlitGeneric"
{
    "$prealpha"             "1"
    // ==============================================================
    // TEXTURE TRANSFORMATION VARIABLES
    // ==============================================================
    "$speed"                "0"
    "$speedScaled"          "0"
    "$speedMax"             "-1"
    "$speedScale"           "-0.000285714285714"
    "$center"               "[0.5 0.5]"
    "$scale"                "[1 1]"
    "$rotate"               "0"
    "$translate"            "[0.0 0.0]"
    "Proxies"
    {
        "Sine"
        {
            "sineperiod"        "6"
            "sinemin"           "0"
            "sinemax"           "2200"
            "resultVar"         "$speed"
        }
        "Equals"
        {
            "srcVar1"           "$prealpha"
            "resultVar"         "$alpha"
        }
        // ==============================================================
        // TRANSFORM TEXTURE
        // ==============================================================
        "Multiply"
        {
            "srcVar1"           "$speed"
            "srcVar2"           "$speedScale"
            "resultVar"         "$speedScaled"
        }
        "Clamp"
        {
            "min"               "$0"
            "max"               "$speedMax"
            "srcVar1"           "$speedScaled"
            "resultVar"         "$translate[0]"
        }
        "TextureTransform"
        {
            "centerVar"             "$center"
            "scaleVar"              "$scale"
            "rotateVar"             "$rotate"
            "translateVar"          "$translate"
            "resultVar"             "$basetexturetransform"
        }
        // ==============================================================
        // COLORS
        // ==============================================================
        // BASE
        // default to white if none of the below conditions are met
        // --------------------------------------------------------------
        "Equals"
        {
            "srcVar1"           "$colorMain"
            "resultVar"         "$color"
        }
        // ==============================================================
        // CLOSE
        // if(speed>closeMin && speed<closeMax)
        // --------------------------------------------------------------
        "LessOrEqual"
        {
            "srcVar1"               "$speed"
            "srcVar2"               "$closeMin"
            "resultVar"             "$isAboveCloseMin"
            "greaterVar"            "$1"
            "lessEqualVar"          "$0"
        }
        "LessOrEqual"
        {
            "srcVar1"               "$speed"
            "srcVar2"               "$closeMax"
            "resultVar"             "$isBelowCloseMax"
            "greaterVar"            "$0"
            "lessEqualVar"          "$1"
        }
        "Multiply"
        {
            "srcVar1"           "$isAboveCloseMin"
            "srcVar2"           "$isBelowCloseMax"
            "resultVar"         "$isClose"
        }
        "LessOrEqual"
        {
            "srcVar1"               "$isClose"
            "srcVar2"               "$0"
            "resultVar"             "$color"
            "greaterVar"            "$colorClose"
            "lessEqualVar"          "$color"
        }
        // ==============================================================
        // GOOD
        // if(speed>goodMin && speed<goodMax)
        // --------------------------------------------------------------
        "LessOrEqual"
        {
            "srcVar1"               "$speed"
            "srcVar2"               "$goodMin"
            "resultVar"             "$isAboveGoodMin"
            "greaterVar"            "$1"
            "lessEqualVar"          "$0"
        }
        "LessOrEqual"
        {
            "srcVar1"               "$speed"
            "srcVar2"               "$goodMax"
            "resultVar"             "$isBelowGoodMax"
            "greaterVar"            "$0"
            "lessEqualVar"          "$1"
        }
        "Multiply"
        {
            "srcVar1"           "$isAboveGoodMin"
            "srcVar2"           "$isBelowGoodMax"
            "resultVar"         "$isGood"
        }
        "LessOrEqual"
        {
            "srcVar1"               "$isGood"
            "srcVar2"               "$0"
            "resultVar"             "$color"
            "greaterVar"            "$colorGood"
            "lessEqualVar"          "$color"
        }
        // ==============================================================
        // ABOVE
        // if(speed>aboveMin && speed<aboveMax)
        // --------------------------------------------------------------
        "LessOrEqual"
        {
            "srcVar1"               "$speed"
            "srcVar2"               "$closeMinB"
            "resultVar"             "$isAboveCloseMinB"
            "greaterVar"            "$1"
            "lessEqualVar"          "$0"
        }
        "LessOrEqual"
        {
            "srcVar1"               "$speed"
            "srcVar2"               "$closeMaxB"
            "resultVar"             "$isBelowCloseMaxB"
            "greaterVar"            "$0"
            "lessEqualVar"          "$1"
        }
        "Multiply"
        {
            "srcVar1"           "$isAboveCloseMinB"
            "srcVar2"           "$isBelowCloseMaxB"
            "resultVar"         "$isCloseB"
        }
        "LessOrEqual"
        {
            "srcVar1"               "$isCloseB"
            "srcVar2"               "$0"
            "resultVar"             "$color"
            "greaterVar"            "$colorClose"
            "lessEqualVar"          "$color"
        }
        // Divide speeds by 10
        "Divide"
        {
            "srcVar1"           "$speed"
            "srcVar2"           "$10"
            "resultVar"         "$speed"
        }
    }
}